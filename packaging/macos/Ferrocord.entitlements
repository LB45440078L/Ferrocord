<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for Developer ID builds (packaging/macos/package.sh).
  The app is not sandboxed, so network access needs no entitlement. Under the hardened
  runtime, camera and microphone access are refused unless declared here, in addition to
  the usage strings in Info.plist. Luau runs as an interpreter, so no JIT entitlement.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
